# ALSF 环境变量示例：复制为 .env 后按需修改（服务端启动时自动读取）
# 游戏端口（默认 24710）
ALSF_PORT=24710
# 管理端独立端口（默认 游戏端口+1；无鉴权，切勿对外暴露）
ALSF_ADMIN_PORT=24711
# 管理端监听地址（默认 127.0.0.1，仅本机；不要改成 0.0.0.0）
ALSF_ADMIN_HOST=127.0.0.1
# 监听地址（默认 0.0.0.0；仅本机使用可改 127.0.0.1）
ALSF_HOST=0.0.0.0
# 回合超时 / 阶段超时 / 掉线宽限（毫秒）
ALSF_TURN_TIMEOUT_MS=90000
ALSF_PHASE_TIMEOUT_MS=60000
ALSF_RECONNECT_GRACE_MS=45000
# 房间空闲回收（毫秒）
ALSF_ROOM_IDLE_MS=90000
